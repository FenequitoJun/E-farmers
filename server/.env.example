# Server Port
PORT=5000

# MongoDB Connection String
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/efarmers

# For MongoDB Atlas (Cloud), replace with your connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/efarmers?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=efarmers_super_secret_jwt_key_2026_change_in_production

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
